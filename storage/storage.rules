rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // User profile photos
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Payment receipts
    //  - user can write their own (2 MB, image/*)
    //  - user can read their own
    //  - admin/staff (custom claim) can read all
    match /receipts/{userId}/{allPaths=**} {
      allow read: if request.auth != null &&
                    (request.auth.uid == userId ||
                     request.auth.token.role in ['admin', 'staff']);
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Accommodation images (admin only)
    match /accommodations/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
                     firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Service photos (uploaded by Telegram bot via admin SDK, public read)
    match /services/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Only via Cloud Functions (admin SDK)
    }

    // Announcement images (from Telegram bot)
    match /announcements/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Only via Cloud Functions (admin SDK)
    }

    // General documents (from Telegram bot)
    match /documents/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // Only via Cloud Functions (admin SDK)
    }

    // Public assets (trails, tours, gallery)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
                     firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isStaff() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff'];
    }

    // ── Users ────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Passes ───────────────────────────────────────────────────────
    match /passes/{passId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if false; // Only via Cloud Functions
      allow update: if isStaff(); // Scan/validate
      allow delete: if isAdmin();
    }

    // ── Accommodations ──────────────────────────────────────────────
    match /accommodations/{docId} {
      allow read: if true; // Public
      allow write: if isAdmin();
    }

    // ── Bookings ────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if false; // Only via Cloud Functions
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Restaurants ─────────────────────────────────────────────────
    match /restaurants/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Reservations ────────────────────────────────────────────────
    match /reservations/{resId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if isAuth();
      allow update: if isOwner(resource.data.userId) || isStaff();
      allow delete: if isAdmin();
    }

    // ── Gondola ─────────────────────────────────────────────────────
    match /gondola_slots/{slotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gondola_tickets/{ticketId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if false; // Only via Cloud Functions
      allow update: if isStaff();
    }

    // ── Tours ───────────────────────────────────────────────────────
    match /tours/{tourId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tour_bookings/{bookingId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if false; // Only via Cloud Functions
      allow update: if isStaff();
    }

    // ── Trails ──────────────────────────────────────────────────────
    match /trails/{trailId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Sauna ───────────────────────────────────────────────────────
    match /sauna_sessions/{sessionId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if false; // Only via Cloud Functions
      allow update: if isStaff();
    }

    // ── Chat ────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth();
      allow update: if isOwner(resource.data.userId) || isAdmin();

      match /messages/{msgId} {
        allow read: if isAuth();
        allow create: if isAuth();
      }
    }

    // ── Payments ────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false; // Only via Cloud Functions
    }

    // ── News ────────────────────────────────────────────────────────
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── SOS ─────────────────────────────────────────────────────────
    match /sos_alerts/{alertId} {
      allow read: if isOwner(resource.data.userId) || isStaff();
      allow create: if isAuth();
      allow update: if isStaff();
    }

    // ── Park Config ─────────────────────────────────────────────────
    match /park_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
